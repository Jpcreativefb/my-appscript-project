 }
+
+
+/* v1.2.18w Survivor + Ranking games */
+.ranking-page,
+.survivor-page { max-width: 980px; margin: 0 auto; padding-bottom: 48px; }
+.ranking-page-header,
+.survivor-page-header { display: flex; gap: 16px; align-items: flex-start; justify-content: space-between; margin-bottom: 18px; }
+.ranking-question-card,
+.survivor-round-card,
+.survivor-history-card,
+.survivor-standings-card { border-radius: 18px; padding: 18px; margin-bottom: 16px; background: var(--surface, #17191f); border: 1px solid var(--border, rgba(255,255,255,.12)); }
+.ranking-order-list { display: grid; gap: 9px; margin: 14px 0; }
+.ranking-entry { display: grid; grid-template-columns: 42px 46px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 10px 12px; border-radius: 12px; border: 1px solid var(--border, rgba(255,255,255,.12)); }
+.ranking-position { font-weight: 800; text-align: center; }
+.ranking-entry-media { width: 42px; height: 42px; display: grid; place-items: center; overflow: hidden; border-radius: 10px; }
+.ranking-entry-media img { width: 100%; height: 100%; object-fit: cover; }
+.ranking-move-buttons { display: flex; gap: 6px; }
+.ranking-move-buttons button { min-width: 42px; min-height: 40px; }
+.ranking-official { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border, rgba(255,255,255,.12)); }
+.survivor-status { display: inline-flex; align-items: center; border-radius: 999px; padding: 6px 10px; font-weight: 800; }
+.survivor-status.alive, .survivor-status-badge.alive { background: rgba(42, 179, 106, .16); }
+.survivor-status.out, .survivor-status-badge.out { background: rgba(224, 67, 67, .16); }
+.survivor-status-badge { display: inline-flex; flex-direction: column; gap: 2px; border-radius: 14px; padding: 10px 12px; font-weight: 800; }
+.survivor-status-badge small { font-weight: 500; opacity: .8; }
+.survivor-card-head { display: flex; gap: 12px; align-items: flex-start; justify-content: space-between; }
+.survivor-round-status { border-radius: 999px; padding: 5px 9px; font-weight: 800; }
+.survivor-choice.selected { outline: 2px solid currentColor; }
+.survivor-choice img, .survivor-choice-placeholder { width: 38px; height: 38px; object-fit: cover; border-radius: 9px; display: grid; place-items: center; }
+.survivor-choice-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 10px; margin: 14px 0; }
+.survivor-choice { display: flex; align-items: center; gap: 10px; min-height: 54px; padding: 12px; border-radius: 12px; border: 1px solid var(--border, rgba(255,255,255,.12)); cursor: pointer; }
+.survivor-choice input { flex: 0 0 auto; }
+.survivor-history-list, .survivor-standings-list { display: grid; gap: 8px; }
+.survivor-history-row, .survivor-standing-row { display: flex; justify-content: space-between; gap: 12px; }
+.admin-ranking-results-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 10px; margin-bottom: 12px; }
+@media (max-width: 640px) {
+  .ranking-page-header, .survivor-page-header { flex-direction: column; }
+  .ranking-entry { grid-template-columns: 34px 42px minmax(0, 1fr); }
+  .ranking-move-buttons { grid-column: 1 / -1; justify-content: flex-end; }
+  .survivor-choice-grid { grid-template-columns: 1fr; }
+}
